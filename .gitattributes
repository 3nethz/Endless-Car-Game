# ============================================================
# Unity 6 .gitattributes
# ============================================================

# Macro definitions
# Unity YAML files — use SmartMerge, treat as text with LF endings
[attr]unity-yaml -text merge=unityyamlmerge eol=lf diff

# Binary LFS files
[attr]lfs -text filter=lfs diff=lfs merge=lfs

# Default: auto-normalize line endings for all text files
* text=auto

# ============================================================
# Unity YAML Assets (SmartMerge + LF)
# ============================================================
*.unity          unity-yaml
*.prefab         unity-yaml
*.asset          unity-yaml
*.meta           unity-yaml
*.mat            unity-yaml
*.anim           unity-yaml
*.controller     unity-yaml
*.overrideController unity-yaml
*.physicMaterial unity-yaml
*.physicsMaterial2D unity-yaml
*.playable       unity-yaml
*.mask           unity-yaml
*.brush          unity-yaml
*.flare          unity-yaml
*.fontsettings   unity-yaml
*.guiskin        unity-yaml
*.mixer          unity-yaml
*.shadervariants unity-yaml
*.spriteatlas    unity-yaml
*.terrainlayer   unity-yaml
*.renderTexture  unity-yaml
*.signal         unity-yaml
*.scenetemplate  unity-yaml

# Assembly definitions (Unity-specific JSON-like, keep as text)
*.asmdef         eol=lf
*.asmref         eol=lf

# ============================================================
# NavMesh and Lighting — large generated binary assets → LFS
# ============================================================
*-[Nn]av[Mm]esh.asset  lfs
*[Ll]ighting[Dd]ata.asset lfs
*[Oo]cclusion[Cc]ulling[Dd]ata.asset lfs

